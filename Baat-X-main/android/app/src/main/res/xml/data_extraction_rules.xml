<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Tokens and pending recordings must never leave the device in a backup. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="baatx_secure_prefs.xml" />
        <exclude domain="database" path="baatx.db" />
        <exclude domain="file" path="pending_audio/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="baatx_secure_prefs.xml" />
        <exclude domain="database" path="baatx.db" />
        <exclude domain="file" path="pending_audio/" />
    </device-transfer>
</data-extraction-rules>
