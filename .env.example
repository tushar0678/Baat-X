# ============ Core ============
ENVIRONMENT=dev                 # dev | staging | prod | test
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
ALLOWED_ORIGINS=*
TRUSTED_HOSTS=*

# ============ Database ============
DATABASE_URL=postgresql+asyncpg://baatx:baatx@localhost:5432/baatx
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============ Redis / queue ============
REDIS_URL=redis://localhost:6379/0
JOB_MAX_TRIES=5
JOB_TIMEOUT_SECONDS=3600        # supports 60+ minute recordings

# ============ Auth ============
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-per-environment
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# ============ Rate limits ============
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AI=30/minute
RATE_LIMIT_AUTH=20/minute

# ============ Audio / storage (temporary only) ============
STORAGE_PROVIDER=azure_blob     # azure_blob | s3 | gcs | local
AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=baatx-temp-audio
# Dev only - prefer Managed Identity in Azure:
# AZURE_STORAGE_CONNECTION_STRING=
AUDIO_MAX_BYTES=209715200       # 200 MB
AUDIO_TEMP_TTL_MINUTES=60
DELETE_AUDIO_AFTER_PROCESSING=true
RETAIN_TRANSCRIPTS=false

# ============ AI providers ============
STT_PROVIDER=azure_speech       # azure_speech | openai_compatible | google | aws | null
LLM_PROVIDER=azure_openai       # azure_openai | openai_compatible | null

AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_USE_MANAGED_IDENTITY=true
# AZURE_OPENAI_API_KEY=         # only when Managed Identity is unavailable

AZURE_SPEECH_REGION=centralindia
# AZURE_SPEECH_KEY=             # from Key Vault
STT_CANDIDATE_LOCALES=hi-IN,en-IN

# Portable fallback
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

LLM_TEMPERATURE=0.1
TRANSCRIPT_CHUNK_CHARS=9000

# ============ Confidence policy ============
CONFIDENCE_HIGH=0.90
CONFIDENCE_MEDIUM=0.60

# ============ WhatsApp (official Business API only) ============
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=        # from Key Vault

# ============ Observability ============
# APPLICATIONINSIGHTS_CONNECTION_STRING=
